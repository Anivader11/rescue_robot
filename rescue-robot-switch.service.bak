# rescue-robot-switch.service
# ============================
# Runs switch_watcher.py at boot so the GPIO switch is armed as soon as
# the Pi finishes starting -- no SSH/keyboard needed.
#
# Install (on the Pi, adjust User/paths below first if yours differ):
#   sudo cp rescue-robot-switch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rescue-robot-switch.service
#
# Check status / logs:
#   sudo systemctl status rescue-robot-switch.service
#   journalctl -u rescue-robot-switch.service -f
#
# Stop/disable:
#   sudo systemctl disable --now rescue-robot-switch.service

[Unit]
Description=Rescue robot switch watcher (starts/stops main.py on GPIO switch)
After=multi-user.target

[Service]
Type=simple
User=nigesh
WorkingDirectory=/home/nigesh/rescue_robot
ExecStart=/home/nigesh/rescue_robot/.venv/bin/python3 /home/nigesh/rescue_robot/switch_watcher.py
Restart=on-failure
RestartSec=2
# GPIO (/dev/gpiomem) and I2C (/dev/i2c-1) access without running as root --
# the user must be in these groups (see install notes below).
SupplementaryGroups=gpio i2c

[Install]
WantedBy=multi-user.target
